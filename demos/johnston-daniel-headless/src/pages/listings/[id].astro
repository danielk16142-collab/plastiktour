---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { getListingById, formatPrice } from "../../lib/cms";

const { id } = Astro.params;
const listing = id ? await getListingById(id) : undefined;

if (!listing) {
  return Astro.redirect("/listings");
}

const galleryImages = listing.gallery.length ? listing.gallery : [listing.mainPhoto];
---

<Layout title={`${listing.title} | Johnston & Daniel`} description={listing.description}>
  <section class="detail-hero">
    <img src={listing.mainPhoto} alt={`${listing.title}, ${listing.address}`} loading="eager" />
    <div class="detail-hero__content reveal">
      <span class={`detail-hero__status detail-hero__status--${listing.status.replace(/\s+/g, "-").toLowerCase()}`}
        >{listing.status}</span
      >
      <h1>{listing.title}</h1>
      <p>{listing.address}</p>
    </div>
  </section>

  <section class="detail">
    <div class="container detail__grid">
      <div class="detail__main reveal">
        <p class="detail__description">{listing.description}</p>
        {
          galleryImages.length > 1 && (
            <div class="detail__gallery">
              {galleryImages.map((src) => (
                <img src={src} alt={`${listing.title} interior view`} loading="lazy" />
              ))}
            </div>
          )
        }
      </div>
      <aside class="detail__sidebar reveal">
        <div class="detail__price">{formatPrice(listing.price)}</div>
        <div class="detail__stats">
          <div>
            <strong>{listing.beds}</strong>
            <span>Beds</span>
          </div>
          <div>
            <strong>{listing.baths}</strong>
            <span>Baths</span>
          </div>
          <div>
            <strong>{listing.sqft.toLocaleString()}</strong>
            <span>Sqft</span>
          </div>
        </div>
        <a href="/team" class="btn detail__cta">Speak with an Advisor</a>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .detail-hero {
    position: relative;
    height: 60vh;
    min-height: 420px;
    display: flex;
    align-items: flex-end;
    color: var(--color-cream);
  }

  .detail-hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .detail-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 20, 20, 0.35) 0%, rgba(20, 20, 20, 0.1) 40%, rgba(20, 20, 20, 0.85) 100%);
    z-index: -1;
  }

  .detail-hero__content {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 40px 56px;
    width: 100%;
  }

  .detail-hero__status {
    display: inline-block;
    background: var(--color-black);
    padding: 7px 14px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 18px;
  }

  .detail-hero__status--sold {
    background: rgba(250, 248, 244, 0.35);
  }

  .detail-hero__status--coming-soon {
    background: var(--color-accent);
    color: var(--color-black);
  }

  .detail-hero__content h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    margin-bottom: 10px;
  }

  .detail-hero__content p {
    font-size: 1.05rem;
    color: rgba(250, 248, 244, 0.9);
  }

  .detail {
    background: var(--color-cream);
  }

  .detail__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .detail__description {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: 40px;
  }

  .detail__gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .detail__gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .detail__sidebar {
    background: var(--color-cream-dim);
    padding: 40px;
    position: sticky;
    top: 120px;
  }

  .detail__price {
    font-family: var(--font-display);
    font-size: 2rem;
    margin-bottom: 24px;
  }

  .detail__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 24px 0;
    margin-bottom: 28px;
  }

  .detail__stats div {
    text-align: center;
  }

  .detail__stats strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.3rem;
  }

  .detail__stats span {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .detail__cta {
    width: 100%;
    text-align: center;
  }

  @media (max-width: 900px) {
    .detail__grid {
      grid-template-columns: 1fr;
    }
    .detail__sidebar {
      position: static;
    }
  }
</style>
