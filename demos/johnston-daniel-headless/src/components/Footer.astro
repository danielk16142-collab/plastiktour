---
// To rebrand: change the agency name, disclaimer, and social links below.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <h3>Johnston &amp; Daniel</h3>
      <p>Excellence in living, since 1978.</p>
    </div>
    <div class="site-footer__col">
      <h4>Explore</h4>
      <ul>
        <li><a href="/listings">Buy</a></li>
        <li><a href="/listings">Sell</a></li>
        <li><a href="/team">Our Team</a></li>
      </ul>
    </div>
    <div class="site-footer__col">
      <h4>Follow</h4>
      <div class="site-footer__socials">
        <a href="#" aria-label="Instagram">
          <svg viewBox="0 0 24 24"
            ><path
              d="M12 8.4a3.6 3.6 0 1 0 0 7.2 3.6 3.6 0 0 0 0-7.2zM12 2c-2.72 0-3.06.01-4.13.06-1.06.05-1.79.22-2.43.47-.66.26-1.22.6-1.77 1.15-.55.55-.89 1.11-1.15 1.77-.25.64-.42 1.37-.47 2.43C2 8.94 2 9.28 2 12s.01 3.06.06 4.13c.05 1.06.22 1.79.47 2.43.26.66.6 1.22 1.15 1.77.55.55 1.11.89 1.77 1.15.64.25 1.37.42 2.43.47C8.94 22 9.28 22 12 22s3.06-.01 4.13-.06c1.06-.05 1.79-.22 2.43-.47.66-.26 1.22-.6 1.77-1.15.55-.55.89-1.11 1.15-1.77.25-.64.42-1.37.47-2.43.05-1.07.06-1.41.06-4.13s-.01-3.06-.06-4.13c-.05-1.06-.22-1.79-.47-2.43a4.9 4.9 0 0 0-1.15-1.77 4.9 4.9 0 0 0-1.77-1.15c-.64-.25-1.37-.42-2.43-.47C15.06 2.01 14.72 2 12 2z"
            ></path></svg
          >
        </a>
        <a href="#" aria-label="Facebook">
          <svg viewBox="0 0 24 24"
            ><path
              d="M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.25-1.5 1.55-1.5H16.7V3.7C16.4 3.66 15.4 3.57 14.24 3.57c-2.42 0-4.08 1.48-4.08 4.19V9.9H7.44V13h2.72v8h3.34z"
            ></path></svg
          >
        </a>
        <a href="#" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24"
            ><path
              d="M6.94 8.5H3.56V20h3.38V8.5zM5.25 3.5a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92zM20.45 20h-3.37v-5.6c0-1.34-.03-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.96V20H9.68V8.5h3.24v1.57h.05c.45-.85 1.55-1.75 3.2-1.75 3.42 0 4.05 2.25 4.05 5.18V20z"
            ></path></svg
          >
        </a>
      </div>
    </div>
    <div class="site-footer__col">
      <h4>Contact</h4>
      <ul>
        <li><a href="tel:+14165550100">(416) 555-0100</a></li>
        <li><a href="mailto:hello@example.com">hello@example.com</a></li>
      </ul>
    </div>
  </div>
  <div class="container">
    <p class="site-footer__disclaimer">
      Johnston &amp; Daniel Advisory Services Inc., Brokerage. Independently owned and operated. All information
      deemed reliable but not guaranteed. This is a concept redesign built for demonstration purposes.
    </p>
    <div class="site-footer__bottom">
      <span>&copy; {year} Johnston &amp; Daniel. All rights reserved.</span>
      <div class="site-footer__legal">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Use</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-black);
    color: rgba(250, 248, 244, 0.85);
    padding: 88px 0 32px;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 56px;
    border-bottom: 1px solid var(--color-border-on-dark);
    margin-bottom: 32px;
  }

  .site-footer__brand h3 {
    color: var(--color-cream);
    font-size: 1.5rem;
    margin-bottom: 10px;
  }

  .site-footer__brand p {
    font-size: 0.9rem;
    color: rgba(250, 248, 244, 0.6);
  }

  .site-footer__col h4 {
    font-family: var(--font-body);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-cream);
    margin-bottom: 20px;
    font-weight: 600;
  }

  .site-footer__col ul li {
    margin-bottom: 12px;
  }

  .site-footer__col a {
    font-size: 0.9rem;
    color: rgba(250, 248, 244, 0.75);
    transition: color var(--transition);
  }

  .site-footer__col a:hover {
    color: var(--color-accent);
  }

  .site-footer__socials {
    display: flex;
    gap: 14px;
  }

  .site-footer__socials a {
    width: 38px;
    height: 38px;
    border: 1px solid var(--color-border-on-dark);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition), border-color var(--transition);
  }

  .site-footer__socials a:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .site-footer__socials svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .site-footer__disclaimer {
    max-width: 900px;
    font-size: 0.78rem;
    color: rgba(250, 248, 244, 0.45);
    margin-bottom: 20px;
    line-height: 1.7;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.8rem;
    color: rgba(250, 248, 244, 0.55);
  }

  .site-footer__legal {
    display: flex;
    gap: 20px;
  }

  @media (max-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
    .site-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
