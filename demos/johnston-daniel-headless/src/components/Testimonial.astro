---
// To rebrand: swap this quote and attribution for a real client testimonial.
---

<section class="testimonial">
  <div class="container testimonial__inner reveal">
    <p class="testimonial__quote">
      "Johnston &amp; Daniel understood exactly what our home was worth, not just in price, but in story. They sold
      it in nine days, to a family who loved it as much as we did."
    </p>
    <p class="testimonial__attribution">Margaret and Alan Whitfield, Rosedale</p>
  </div>
</section>

<style>
  .testimonial {
    background: var(--color-cream-dim);
  }

  .testimonial__inner {
    max-width: 900px;
    text-align: center;
    margin: 0 auto;
  }

  .testimonial__quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.5rem, 3.2vw, 2.4rem);
    line-height: 1.4;
    margin-bottom: 28px;
  }

  .testimonial__attribution {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }
</style>
