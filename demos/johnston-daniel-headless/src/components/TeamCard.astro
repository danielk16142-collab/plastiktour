---
import type { TeamMember } from "../lib/cms";

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
---

<article class="team-card">
  <div class="team-card__photo">
    <img src={member.headshot} alt={`Portrait of ${member.name}`} loading="lazy" />
  </div>
  <h3 class="team-card__name">{member.name}</h3>
  <p class="team-card__title">{member.title}</p>
  {member.bio && <p class="team-card__bio">{member.bio}</p>}
  <div class="team-card__contact">
    {member.email && <a href={`mailto:${member.email}`}>Email</a>}
    {member.phone && <a href={`tel:${member.phone.replace(/[^\d+]/g, "")}`}>Call</a>}
  </div>
</article>

<style>
  .team-card {
    text-align: left;
  }

  .team-card__photo {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .team-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%);
    transition: transform 0.7s ease, filter 0.7s ease;
  }

  .team-card:hover .team-card__photo img {
    transform: scale(1.04);
    filter: grayscale(0%);
  }

  .team-card__name {
    font-size: 1.15rem;
    margin-bottom: 4px;
  }

  .team-card__title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: 14px;
  }

  .team-card__bio {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    margin-bottom: 16px;
  }

  .team-card__contact {
    display: flex;
    gap: 18px;
  }

  .team-card__contact a {
    font-size: 0.76rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-black);
    border-bottom: 1px solid var(--color-black);
    padding-bottom: 3px;
    transition: color var(--transition), border-color var(--transition);
  }

  .team-card__contact a:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
