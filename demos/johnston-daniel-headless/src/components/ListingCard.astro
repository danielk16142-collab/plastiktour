---
import type { Listing } from "../lib/cms";
import { formatPrice } from "../lib/cms";

interface Props {
  listing: Listing;
  size?: "large" | "medium" | "small";
}

const { listing, size = "medium" } = Astro.props;
---

<article class={`listing-card listing-card--${size}`}>
  <a href={`/listings/${listing._id}`} class="listing-card__photo-link">
    <div class="listing-card__photo">
      <img src={listing.mainPhoto} alt={`${listing.title}, ${listing.address}`} loading="lazy" />
      <span class={`listing-card__status listing-card__status--${listing.status.replace(/\s+/g, "-").toLowerCase()}`}
        >{listing.status}</span
      >
    </div>
  </a>
  <div class="listing-card__body">
    <div class="listing-card__price">{formatPrice(listing.price)}</div>
    <h3 class="listing-card__title">{listing.title}</h3>
    <p class="listing-card__address">{listing.address}</p>
    <div class="listing-card__stats">
      <span><strong>{listing.beds}</strong> Beds</span>
      <span><strong>{listing.baths}</strong> Baths</span>
      <span><strong>{listing.sqft.toLocaleString()}</strong> Sqft</span>
    </div>
    <a href={`/listings/${listing._id}`} class="listing-card__link">View Details</a>
  </div>
</article>

<style>
  .listing-card {
    background: var(--color-cream);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .listing-card__photo-link {
    display: block;
  }

  .listing-card__photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .listing-card--large .listing-card__photo {
    aspect-ratio: 16 / 11;
  }

  .listing-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .listing-card:hover .listing-card__photo img {
    transform: scale(1.05);
  }

  .listing-card__status {
    position: absolute;
    top: 16px;
    left: 16px;
    background: var(--color-black);
    color: var(--color-cream);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 7px 14px;
  }

  .listing-card__status--sold {
    background: var(--color-text-muted);
  }

  .listing-card__status--coming-soon {
    background: var(--color-accent);
    color: var(--color-black);
  }

  .listing-card__body {
    padding: 26px 4px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .listing-card--large .listing-card__body {
    padding: 32px 4px;
  }

  .listing-card__price {
    font-family: var(--font-display);
    font-size: 1.4rem;
    margin-bottom: 6px;
  }

  .listing-card--large .listing-card__price {
    font-size: 1.9rem;
  }

  .listing-card__title {
    font-size: 1.05rem;
    font-weight: 500;
    margin-bottom: 4px;
  }

  .listing-card__address {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    margin-bottom: 18px;
  }

  .listing-card__stats {
    display: flex;
    gap: 16px;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    padding-top: 14px;
    margin-bottom: 18px;
    margin-top: auto;
  }

  .listing-card__stats strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .listing-card__link {
    display: inline-block;
    font-size: 0.76rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-black);
    border-bottom: 1px solid var(--color-black);
    padding-bottom: 3px;
    align-self: flex-start;
    transition: color var(--transition), border-color var(--transition);
  }

  .listing-card__link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
