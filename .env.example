# Anthropic Claude AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# WhatsApp Business API (Meta)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# Wix App (auto-managed by Wix CLI, do not edit manually)
# WIX_APP_ID=set_by_wix_cli
# WIX_APP_SECRET=set_by_wix_cli

# Wix Headless (self-managed) — admin client-credentials access to the Nocturne site
# Client created via Settings > Headless Settings (or the OAuth Apps API) on the target site.
WIX_SITE_ID=your_wix_site_id_here
WIX_CLIENT_ID=your_headless_client_id_here
WIX_CLIENT_SECRET=your_headless_client_secret_here

# Wix CLI login (account-level API key from manage.wix.com/account/api-keys)
# Use with: npx wix login --api-key "$WIX_CLI_API_KEY"
WIX_CLI_API_KEY=your_wix_cli_api_key_here
